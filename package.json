    "verify:qloo-coverage": "node scripts/audit-qloo-coverage.mjs",
    "verify:qloo-transfer": "node --experimental-strip-types scripts/verify-qloo-transfer.mjs",
    "benchmark": "node --experimental-strip-types scripts/benchmark/run.mjs",
    "benchmark:cli": "node --experimental-strip-types scripts/benchmark/collect-cli.mjs",
