{
  "name": "tpd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types scripts/check-passport.mjs && node scripts/check-prototype.cjs && node --experimental-strip-types --conditions=react-server scripts/check-discovery.mjs && node scripts/check-benchmark.mjs && node scripts/check-benchmark-cli.mjs && node scripts/check-benchmark-verification.mjs && node scripts/check-benchmark-review.mjs && node --experimental-strip-types --conditions=react-server scripts/check-place-verification.mjs",
    "verify:qloo": "node scripts/verify-qloo.mjs",
    "verify:qloo-features": "node scripts/check-qloo-features.mjs",
